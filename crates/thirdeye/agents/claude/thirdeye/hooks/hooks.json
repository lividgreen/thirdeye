{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/thirdeye-hook.sh\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/thirdeye-hook.sh\"",
            "shell": "bash",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/thirdeye-hook.sh\"",
            "shell": "bash",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/thirdeye-hook.sh\"",
            "shell": "bash",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/thirdeye-hook.sh\"",
            "shell": "bash",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/thirdeye-hook.sh\"",
            "shell": "bash",
            "async": true
          }
        ]
      }
    ]
  }
}
